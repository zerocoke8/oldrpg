{
  "name": "oldrpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "tsx test/acceptance.ts",
    "test:browser": "tsx test/browser.ts",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:pipeline && npm run test:events && npm run test:regions && npm run test:combat && npm run test:npc && npm run test:items && npm run test:balance && npm run test:world && npm run test:guild && npm run test:missions && npm run test:author && npm run test:deploy && npm run test:browser",
    "test:pipeline": "tsx test/pipeline.ts",
    "test:events": "tsx test/events.ts",
    "test:regions": "tsx test/regions.ts",
    "test:combat": "tsx test/combat.ts",
    "test:npc": "tsx test/npc.ts",
    "test:items": "tsx test/items.ts",
    "pregen": "tsx server/tools/pregen.ts",
    "author": "tsx server/tools/authorRegion.ts",
    "sim": "tsx server/tools/balanceSim.ts",
    "start": "node --import tsx server/index.ts",
    "test:deploy": "tsx test/deploy.ts",
    "test:balance": "tsx test/balance.ts",
    "test:world": "tsx test/world.ts",
    "test:guild": "tsx test/guild.ts",
    "test:missions": "tsx test/missions.ts",
    "test:author": "tsx test/author.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "better-sqlite3": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
