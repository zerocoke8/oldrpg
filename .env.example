# 이 파일을 .env 로 복사하고 키를 채운다. .env 는 .gitignore 되어 있다.
# 키가 없으면 서버는 그냥 결정론적 폴백 문장만 쓴다 (1단계와 동일하게 동작).

# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 선택. 기본값은 claude-opus-5.
# 비용을 낮추려면 claude-sonnet-5 / claude-haiku-4-5 로 바꿀 수 있다 —
# 방 묘사는 짧은 창작이라 체감 차이가 작은 편이다. 운영자의 결정이다.
# MUD_MODEL=claude-sonnet-5

# 선택
# MUD_DB=mud.db
# MUD_PORT=8787
